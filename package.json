{
  "name": "little-hanzi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test --test-concurrency=2 tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve-lan.mjs",
    "qa:prepare": "node scripts/qa-prepare.mjs",
    "test:integration": "node scripts/qa-run.mjs integration",
    "test:e2e": "node scripts/qa-run.mjs e2e",
    "preview:serve": "node scripts/preview-serve.mjs",
    "test:pilot": "node --experimental-strip-types scripts/pilot-qa.mjs",
    "test:pilot-learning": "node --experimental-strip-types scripts/pilot-qa.mjs --learning",
    "test:pilot-curriculum": "node --experimental-strip-types scripts/pilot-qa.mjs --curriculum",
    "test:pilot-curriculum-runtime": "node --experimental-strip-types scripts/pilot-curriculum-runtime-qa.mjs",
    "test:pilot-restore": "node --experimental-strip-types scripts/pilot-qa.mjs --restore",
    "test:pilot-curriculum-restore": "node --experimental-strip-types scripts/pilot-qa.mjs --curriculum-restore",
    "test:pilot-runtime-restore": "node --experimental-strip-types scripts/pilot-qa.mjs --runtime-restore",
    "test:pilot-e2e": "node --experimental-strip-types scripts/pilot-browser-qa.mjs",
    "test:pilot-ops-http": "node --experimental-strip-types --test tests/readiness-ops-http-restore.integration.mjs",
    "test:corpus-database": "node --experimental-strip-types --test tests/readiness-corpus-database.integration.mjs",
    "curriculum:check": "node --experimental-strip-types scripts/curriculum-check.mjs",
    "pilot:backup": "node --experimental-strip-types scripts/pilot-backup.mjs backup",
    "pilot:restore": "node --experimental-strip-types scripts/pilot-backup.mjs restore",
    "pilot:operator": "node --experimental-strip-types scripts/pilot-accounts.mjs",
    "test:pilot-backup-schema": "node --experimental-strip-types tests/pilot-backup-schema-integration.mjs",
    "test:pilot-review-desk": "node --experimental-strip-types scripts/pilot-qa.mjs --review-desk",
    "build:vercel": "vite build --config vite.vercel.config.ts",
    "build:node": "NITRO_PRESET=node vite build --config vite.vercel.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@libsql/client": "0.18.0",
    "@shadcn/react": "0.3.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.3",
    "hanzi-writer": "^3.7.3",
    "lucide-react": "1.31.0",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.1",
    "@cloudflare/workers-types": "5.20260923.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "wrangler": "4.140.0"
  },
  "type": "module"
}
